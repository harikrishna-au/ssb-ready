# Copy to .env and fill values. (.env must stay out of git.)

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
# Public bucket that holds the fixed PPDT/TAT image set
PSYCHOLOGY_IMAGE_BUCKET=ppdt-tat-images

# Lifetime premium checkout uses SUPABASE_URL/functions/v1/lifetime-premium.
# Razorpay keys stay only in Supabase Edge Function secrets, never in the app.

# Production backend — no trailing slash
BACKEND_URL=https://ssb-ready.onrender.com

# Optional: only if BACKEND_URL is unset (direct Gemini from device)
# GEMINI_API_KEY=
