NODE_ENV=development
HOST=0.0.0.0
PORT=5000

# Comma-separated browser origins (Flutter web, etc.). Use * only with care.
CORS_ORIGIN=http://localhost:3000,http://localhost:8080

# Public base URL of this API (no trailing slash). On Render use your service URL.
PUBLIC_URL=https://ssb-ready.onrender.com
# Alias: BACKEND_PUBLIC_URL

# Shown on the public privacy policy page (Play Console / App Store URL)
SUPPORT_EMAIL=support@ssbready.app

# Max JSON body size for OCR uploads etc.
# JSON_BODY_LIMIT=15mb

SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_key_or_service_role
# Bucket for OIR image imports (create in Supabase Storage; public read recommended)
SUPABASE_STORAGE_BUCKET=oir-questions
# Shared PPDT/TAT image bucket
PSYCHOLOGY_IMAGE_BUCKET=ppdt-tat-images
JWT_SECRET=set_a_long_random_secret

OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
# Optional: mock interview + /api/interview/prep; defaults to OPENAI_MODEL
OPENAI_INTERVIEW_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
AI_PROMPT_MAX_CHARS=12000

FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket
# Production / Render: paste the entire Firebase service account JSON as one line (Render secret).
# Optional locally if you use GOOGLE_APPLICATION_CREDENTIALS to a file instead.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Used by the Supabase lifetime-premium Edge Function when it syncs paid users
# back into Firestore via /api/firestore/user/profile.
BACKEND_URL=https://ssb-ready.onrender.com
