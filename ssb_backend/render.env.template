# Paste into Render: Dashboard → Web Service → Environment
# Replace ALL placeholder values. Do NOT commit real secrets.
#
# Omit PORT — Render sets it automatically.

NODE_ENV=production
HOST=0.0.0.0

# Your Render service URL (no trailing slash).
PUBLIC_URL=https://ssb-ready.onrender.com

CORS_ORIGIN=http://localhost:8080,http://localhost:3000,http://127.0.0.1:8080

# Large JSON/OCR payloads
JSON_BODY_LIMIT=15mb

# Required at startup — use Supabase project URL + key (anon or service_role per your routes).
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# User data (results, PIQ, profiles) lives in a PRIVATE Supabase table, so the backend needs the SERVICE-ROLE key.
# The public anon key is refused at startup of any database call. Never put the service-role key in the web app.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_KEY=
SUPABASE_STORAGE_BUCKET=oir-questions

# Any long random string (used by bootstrap).
JWT_SECRET=YOUR_LONG_RANDOM_SECRET

# OpenAI (required for /api/evaluate, /api/ppdt, pipelines, OCR)
OPENAI_API_KEY=YOUR_OPENAI_KEY
OPENAI_MODEL=gpt-4o-mini
OPENAI_INTERVIEW_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
AI_PROMPT_MAX_CHARS=12000


# CRITICAL on Render: full service-account JSON as ONE line — add as Render "Secret".
CLERK_SECRET_KEY=
